{
  "name": "dsh-troubleshooting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "运行于本机的 DeepSeek Harness 测试群排障扩展",
  "main": "src/plugin.mjs",
  "files": ["src", "config/demo.json", "config/browser-demo.json", "config/repair-demo.json", "config/company.example.json", "config/services.example.json", "config/ssh.example.conf", "fixtures", "mock", "scripts", "test", ".agents/skills", "docs", "cordis.patch.yml", "README.md"],
